@page "/"
@model Bison.Razor.Pages.PublicModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div class=navigation>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div>
            <a href="/@(User.Identity.Name)">My Observations</a> |
            <a href="/">Public Observations</a> |
            <a href="/AboutMe">About Me</a> |
            <a href="/Identity/Account/Logout">Logout [@(User.Identity.Name)]</a>
        </div>
    }
    else
    {
        <div>
            <a href="/">Public Observations</a> |
            <a href="/Identity/Account/Register">Register</a>
            <a href="/Identity/Account/Login">Login</a>
        </div>

        
        
    }
</div>


<div>

    @if (User.Identity?.IsAuthenticated != true)

    {
        <h2> Log in to post a what you saw</h2>
        
    }
    

    @if (User.Identity?.IsAuthenticated == true)
    {


        <div class="observationbox">
            <h3>What did you see, @(User.Identity.Name)?</h3>
            <form method="post">
                <input style="float: left" type="text" asp-for="description">

                <div style="clear: both;">
                    <label for="license">How may other people use your picture?</label>
                    <select name="license" id="license" required>
                        <option value="" disabled selected>Select a license</option>
                        <!--people may use your picture as they please</p> -->
                        <option value="CC0 1.0">CC0 1.0 - no restrictions</option>
                        <!--people may use your picture, but must give credit</p> -->
                        <option value="CC BY 4.0">CC BY 4.0 - Credit required</option>
                        <!--pic may be shared, but not changed in any way</p> -->
                        <option value="CC BY-ND 4.0">CC BY-ND 4.0 - No sharing adaptations</option>
                        <!--others may use picture but not for commercial purposes</p> -->
                        <option value="CC BY-NC 4.0">CC BY-NC 4.0 - Non-commercial use only</option>
                    </select>
                </div>

                <input type="submit" value="Share">

            </form>
        </div>
    }
</div>
<div>
    <h2> Public Timeline </h2>
    
    <form method="get">
        <label for="taxonId">Filter by taxon:</label>

        <select name="taxonId" id="taxonId" onchange="this.form.submit()">

            <option value="">All taxa</option>

            @* Only display taxa with readable names. *@
            @foreach (var taxon in Model.Taxons
                .Where(t => !string.IsNullOrWhiteSpace(t.VernacularName)))
            {
                <option value="@taxon.TaxonId" selected="@(Model.SelectedTaxonId == taxon.TaxonId)">
                    @taxon.VernacularName
                </option>
            }
        </select>
    </form>


    @if (Model.Observations?.Any() == true)
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/@obs.Author">@obs.Author</a>
                        </strong>
                        <a href="/ob/@obs.ObservationId">
                            @obs.Message
                        </a>
                        <small>&mdash; @obs.Timestamp</small>
                    </p>
                    @if (!string.IsNullOrWhiteSpace(obs.PictureUrl))
                    {
                        <img src="@obs.PictureUrl" alt="Animal observed by @obs.Author" class="observation-picture"
                             loading="lazy" />
                    }
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }

    @{
        string taxonQuery = Model.SelectedTaxonId.HasValue ? $"&taxonId={Model.SelectedTaxonId.Value}" : "";
    }

    <nav class="pagination" aria-label="Observation pages">

        @* Previous page *@

        @if (Model.CurrentPage > 1)
        {
            <a href="@($"/?page={Model.CurrentPage - 1}{taxonQuery}")" class="page-button">

                Previous
            </a>
        }
        else
        {
            <span class="page-button disabled">Previous</span>
        }

        @* Numbered pagination *@
        <div class="page-numbers">
            @foreach (int? pageNumber in Model.VisiblePages)
            {
                if (pageNumber == null)
                {
                    <span class="page-ellipsis" aria-hidden="true">...</span>
                }
                else if (pageNumber == Model.CurrentPage)
                {
                    <span class="page-number active" aria-current="page">
                        @pageNumber
                    </span>
                }
                else
                {
                    <a href="@($"/?page={pageNumber}{taxonQuery}")" class="page-number" aria-label="Go to page @pageNumber">
                        @pageNumber
                    </a>
                }
            }
        </div>

        @* Next page *@
        @if (Model.HasNextPage)
        {
            <a href="@($"/?page={Model.CurrentPage + 1}{taxonQuery}")" class="page-button">

                Next
            </a>
        }
        else
        {
            <span class="page-button disabled">Next</span>
        }

    </nav>
</div>
