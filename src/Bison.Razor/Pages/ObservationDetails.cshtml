@page "/ob/{id:int?}"
@model Bison.Razor.Pages.ObservationDetailsModel

@{
    ViewData["Title"] = "Observation";
    Layout = "Shared/_Layout";
}

<div>
    <h2>Observation</h2>

    <p>
        <strong>@Model.Observation!.Author</strong>
        @Model.Observation.Message
        <small>
            &mdash; @Model.Observation.Timestamp
        </small>
    </p>
    @if (!string.IsNullOrWhiteSpace(Model.Observation.PictureUrl)) {
            <img src="@Model.Observation.PictureUrl"
                alt="Animal observed by @Model.Observation.Author"
                class="observation-picture"
                loading="lazy" />
        }

    <h3>Comments</h3>

    @if (User?.Identity?.IsAuthenticated == true)
    {
        <div class="observationbox">
            <h3>Post Comment</h3>
            <form method="post">
                <input type="hidden" asp-for="ObservationId" required />
                <input style="float: left" type="text" asp-for="Description">
                <input type="submit" asp-page-handler="Comment" value="Post">
            </form>
        </div>
    }
    @if (Model.Observation.Comments.Any()) {
        <ul>
            @foreach (var comment in Model.Observation.Comments) {
                <li>
                    <strong>@comment.Author</strong>
                    @comment.Message
                    <small>
                        &mdash; @comment.Timestamp
                    </small>
                </li>
            }
        </ul>
    }
    else {
        <p>No comments.</p>
    }

    <h3>Proposals</h3>

    @if (User?.Identity?.IsAuthenticated == true)
    {
        <div class="observationbox">
            <h3>Propose Taxon</h3>
            <form method="post">
                <input type="hidden" asp-for="ObservationId" required />

                <label for="taxonId">Taxon:</label>
                <select asp-for="SelectedTaxonId">
                    <option value="">All taxa</option>
                    @* Only display taxa with readable names. *@
                    @foreach (var taxon in Model.Taxons
                        .Where(t => !string.IsNullOrWhiteSpace(t.VernacularName)))
                    {
                        <option value="@taxon.TaxonId">
                            @taxon.VernacularName
                        </option>
                    }
                </select>
                
                <input type="submit" asp-page-handler="Proposal" value="Post">
            </form>
        </div>
    }

    <!--<form method="get">
    </form>-->

    @if (Model.Observation.Proposals.Any()) {
        <ul>
            @foreach (var proposal in Model.Observation.Proposals) {
                <li>
                    <strong>@proposal.Author</strong>
                    proposed @(Model.Taxons.FirstOrDefault(t => t.DwcTaxonId == proposal.TaxonId)?.VernacularName ?? "Unknown Vernacular Name")
                    <small>
                        &mdash; @proposal.Timestamp
                    </small>
                </li>
            }
        </ul>
    }
    else {
        <p>No proposals.</p>
    }
</div>